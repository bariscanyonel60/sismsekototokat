# Canonical / OG / sitemap için gerçek alan adı
NEXT_PUBLIC_SITE_URL=

# Google Search Console doğrulama kodu (HTML etiketi yöntemindeki content değeri)
GOOGLE_SITE_VERIFICATION=

# Admin paneli (/admin). Şifre hash'i ve oturum anahtarı için: npm run admin:hash -- "guclu-sifre"
# Şifrenin kendisi buraya yazılmaz; komutun ürettiği scrypt.... değeri .env.local'a girer.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
